{
  "name": "@twistedsignal/raven",
  "version": "0.3.0",
  "description": "A CLI for the Roblox Open Cloud API",
  "license": "MIT",
  "author": "Twisted Signal",
  "type": "module",
  "bin": {
    "raven": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.mjs",
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "roblox",
    "opencloud",
    "open-cloud",
    "cli",
    "datastore",
    "assets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twistedsignal/raven.git"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.28.2"
}
